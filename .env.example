# Те же переменные, что у прежнего бота (Railway → Variables) — менять ничего не нужно
BOT_TOKEN=123456:ABC...
DATABASE_URL=
ARTEM_CHAT_ID=222222222
WORK_CHAT_ID=-100333333333
ADMIN_IDS=111111111,222222222

# Новые, все необязательные
# LEADS_CHAT_ID=      куда слать заявки (по умолчанию WORK_CHAT_ID, если нет — ARTEM_CHAT_ID)
# SET_AVATAR=1        поставить анимированную аватарку при первом запуске (1/0)
# MEDIA_WARMUP_CHAT_ID=  служебный канал для предзагрузки медиа (file_id), необязательно
# SLOT_FROM_H=11  SLOT_TO_H=21  SLOT_LEN_MIN=30  SLOT_STEP_MIN=90  SLOT_MIN_AHEAD_MIN=60   окна записи (МСК)
# PARTNER_NEXT_SEC=60   «Далее» в партнёрстве: через сколько секунд следующее сообщение придёт само
